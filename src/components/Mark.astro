---
// TB monogram drawn as a single-weight toolpath; the orange dot is the nozzle tip.
interface Props { class?: string; mono?: boolean; }
const { class: cls, mono = false } = Astro.props;
---
<svg class={cls} viewBox="0 0 68 64" role="img" aria-label="TB monogram" xmlns="http://www.w3.org/2000/svg">
  <path d="M6 12H42a10 10 0 0 1 0 20H30M30 12V52H44a10 10 0 0 0 0-20H30M17 12V52" fill="none" stroke="currentColor"
    stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="62.5" cy="50.75" r="4" fill={mono ? 'currentColor' : '#F26A1B'} />
</svg>
