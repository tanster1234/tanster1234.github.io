---
// Decorative band between the intro and the work. It repeats what the sections below say,
// so it is hidden from assistive tech.
const words = ['Forecasting', 'AI agents', 'Real-time data', 'Full-stack', 'Trading systems', '3D printing', 'Design'];
const run = [...words, ...words];
---
<section class="marquee" data-marquee aria-hidden="true" data-theme="light">
  <div class="marquee-track">
    {[0, 1].map(() => (
      <div class="marquee-run">
        {run.map((w, i) => (
          <>
            <span class:list={['mw', { hollow: i % 2 === 1 }]}>{w}</span>
            <span class="nozzle"></span>
          </>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .marquee { background: var(--bone); border-block: 1px solid var(--line-light); overflow: hidden; padding-block: clamp(18px, 3vw, 34px); }
  .marquee-track { display: flex; width: max-content; will-change: transform; }
  .marquee-run { display: flex; align-items: center; gap: clamp(18px, 2.4vw, 40px); padding-right: clamp(18px, 2.4vw, 40px); }
  .mw { font-family: var(--f-display); font-size: clamp(44px, 8vw, 128px); line-height: 1; letter-spacing: -0.02em; white-space: nowrap;
    font-variation-settings: 'wdth' 125, 'wght' 820; color: var(--ink); }
  .mw.hollow { color: transparent; -webkit-text-stroke: 1.5px var(--ink); }
  .nozzle { width: clamp(12px, 1.4vw, 20px); aspect-ratio: 1; border-radius: 50%; background: var(--orange); flex: none;
    box-shadow: 0 0 0 6px rgba(242, 106, 27, 0.15); }
  @media (prefers-reduced-motion: reduce) { .marquee-track { transform: none !important; } }
</style>
