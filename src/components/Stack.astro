---
import { stack } from '../data/content';
---
<section id="stack" class="stack" data-theme="light">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow"><span class="semi">;</span> layer 03 · stack</p>
      <h2 class="h-section" data-rise="chars">Tools, by job</h2>
    </header>
    <div class="cols">
      {stack.map((g) => (
        <div class="col">
          <h3>{g.use}</h3>
          <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack { background: var(--bone); padding-block: clamp(80px, 12vh, 140px); border-top: 1px solid var(--line-light); }
  .head { display: grid; gap: 18px; margin-bottom: clamp(32px, 4vw, 56px); }
  .cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  .col { border-top: 2px solid var(--ink); padding-top: 16px; display: grid; gap: 12px; align-content: start; }
  .col h3 { font-family: var(--f-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 500; color: var(--slate); }
  .col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .col li { font-family: var(--f-display); font-size: clamp(19px, 1.6vw, 23px); font-variation-settings: 'wdth' 106, 'wght' 620; line-height: 1.2; }
  @media (max-width: 900px) { .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .cols { grid-template-columns: minmax(0, 1fr); } }
</style>
