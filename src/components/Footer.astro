---
import Mark from './Mark.astro';
import { person } from '../data/content';
const formId = import.meta.env.PUBLIC_FORMSPREE_ID as string | undefined;
const year = new Date().getFullYear();
---
<footer id="contact" class="foot on-dark" data-theme="dark">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow"><span class="semi">;</span> end of print</p>
      <h2 class="h-section wave" data-wave aria-label="Say hello.">
        {'Say hello'.split('').map((c) => c === ' ' ? <span class="sp"> </span> : <span class="wc" aria-hidden="true">{c}</span>)}<span class="wc dot" aria-hidden="true">.</span>
      </h2>
      <p class="lede">The fastest way to reach me is a message on LinkedIn. Code lives on GitHub.</p>
      <div class="links">
        <a class="social" href={person.links.linkedin} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
          LinkedIn
        </a>
        <a class="social" href={person.links.github} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.4-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.23 2.88.11 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .31.22.69.83.57A12 12 0 0 0 12 .3"/></svg>
          GitHub
        </a>
      </div>
    </div>
    {formId && (
      <form class="form" action={`https://formspree.io/f/${formId}`} method="POST">
        <label for="c-name">Name</label>
        <input id="c-name" name="name" autocomplete="name" required />
        <label for="c-email">Email</label>
        <input id="c-email" name="email" type="email" autocomplete="email" required />
        <label for="c-msg">What are you working on?</label>
        <textarea id="c-msg" name="message" rows="4" required></textarea>
        <button class="btn primary" type="submit"><span class="led"></span>Send</button>
      </form>
    )}
  </div>
  <div class="wrap base">
    <span class="sig"><Mark class="sig-mark" /> {person.name}</span>
    <span>© {year} · Designed and built by me · Film generated with Higgsfield</span>
  </div>
</footer>

<style>
  .foot { background: var(--deep); color: var(--bone); padding-block: clamp(96px, 14vh, 150px) 28px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .copy { display: grid; gap: 22px; }
  .h-section .dot { color: var(--orange); }
  .wave { font-size: clamp(56px, 11vw, 176px); letter-spacing: -0.02em; white-space: nowrap; cursor: default; }
  .wave .wc { display: inline-block; font-variation-settings: 'wdth' var(--w, 125), 'wght' var(--g, 820); }
  .wave .sp { display: inline-block; width: 0.28em; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; }
  .social { display: inline-flex; align-items: center; gap: 10px; padding: 14px 20px; border-radius: 999px; border: 1px solid var(--line-dark);
    color: var(--bone); text-decoration: none; font-family: var(--f-mono); font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; }
  .social:hover { border-color: var(--orange); }
  .social svg { width: 16px; height: 16px; }
  .form { display: grid; gap: 8px; }
  .form label { font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--fog); margin-top: 8px; }
  .form input, .form textarea { font: inherit; font-size: 16px; color: var(--bone); background: var(--plate); border: 1px solid var(--line-dark); border-radius: 10px; padding: 12px 14px; }
  .form input:focus, .form textarea:focus { outline: 2px solid var(--orange); outline-offset: 1px; }
  .form .btn { justify-self: start; margin-top: 12px; }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-top: clamp(64px, 10vh, 120px); padding-top: 20px; border-top: 1px solid var(--line-dark);
    font-family: var(--f-mono); font-size: 11px; color: var(--fog); }
  .sig { display: inline-flex; align-items: center; gap: 10px; color: var(--bone); }
  .sig :global(.sig-mark) { width: 22px; height: auto; }
  @media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
