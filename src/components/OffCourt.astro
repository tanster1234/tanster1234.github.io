---
// Short and personal. Only facts the owner has confirmed.
---
<section id="off-court" class="court on-dark" data-theme="dark">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow"><span class="semi">;</span> layer 05 · off-court</p>
      <h2 class="h-section" data-rise="chars">Off-court</h2>
      <p class="lede">Knicks fan and fantasy hoops regular. I printed our league's trophy, and a HueForge poster of the Knicks' Finals run.</p>
    </div>
    <svg class="arc" viewBox="0 0 600 360" role="img" aria-label="A shot arc drawn as a fitted curve landing in a hoop">
      <defs>
        <linearGradient id="arcfade" x1="0" x2="1"><stop offset="0" stop-color="#e9e7e1" stop-opacity=".2" /><stop offset="1" stop-color="#f26a1b" /></linearGradient>
      </defs>
      <g stroke="rgba(233,231,225,.12)" stroke-width="1">
        <line x1="20" y1="320" x2="580" y2="320" />
        <line x1="20" y1="240" x2="580" y2="240" stroke-dasharray="2 6" />
        <line x1="20" y1="160" x2="580" y2="160" stroke-dasharray="2 6" />
        <line x1="20" y1="80" x2="580" y2="80" stroke-dasharray="2 6" />
      </g>
      <g fill="#9da1a8" opacity=".85">
        <circle cx="60" cy="286" r="3" /><circle cx="110" cy="214" r="3" /><circle cx="162" cy="160" r="3" />
        <circle cx="214" cy="120" r="3" /><circle cx="268" cy="98" r="3" /><circle cx="322" cy="92" r="3" />
        <circle cx="376" cy="104" r="3" /><circle cx="430" cy="132" r="3" />
      </g>
      <path class="fit" d="M60 290 Q 300 -30 520 212" fill="none" stroke="url(#arcfade)" stroke-width="3" stroke-linecap="round" />
      <g stroke="#e9e7e1" stroke-width="3" fill="none" stroke-linecap="round">
        <line x1="560" y1="150" x2="560" y2="320" />
        <line x1="560" y1="200" x2="532" y2="200" />
        <ellipse cx="515" cy="204" rx="22" ry="5" stroke="#f26a1b" />
      </g>
      <text x="24" y="346" fill="#9da1a8" font-family="Martian Mono, monospace" font-size="11">fit: y = ax² + bx + c</text>
    </svg>
  </div>
</section>

<style>
  .court { background: var(--deep); color: var(--bone); padding-block: clamp(96px, 14vh, 160px); border-top: 1px solid var(--line-dark); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .copy { display: grid; gap: 20px; }
  .arc { width: 100%; height: auto; }
  .js .arc .fit { stroke-dasharray: 700; stroke-dashoffset: 700; transition: stroke-dashoffset 1.6s var(--ease); }
  .js .arc.go .fit { stroke-dashoffset: 0; }
  @media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
