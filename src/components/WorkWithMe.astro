---
import { person } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id="work-with-me" class="wwm" data-theme="light">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow"><span class="semi">;</span> layer 06 · work with me</p>
      <h2 class="h-section" data-rise="chars">Want a site like this?</h2>
      <p class="lede">I design and build personal and product sites end to end: the story, the art direction, generated film, and the code that keeps it smooth.</p>
      <div class="ctas">
        <a class="btn primary" href={person.links.linkedin} target="_blank" rel="noopener"><span class="led"></span>Start a project</a>
        <a class="btn" href={`${base}/how-this-was-built/`}>Read the build notes</a>
      </div>
    </div>
    <ol class="steps">
      <li><span class="n">01</span><div><h3>Story</h3><p>One idea the whole page carries, pitched as concepts before anything is built.</p></div></li>
      <li><span class="n">02</span><div><h3>Art direction</h3><p>Palette, type and a mark that belong to you, drawn from your own world.</p></div></li>
      <li><span class="n">03</span><div><h3>Film &amp; motion</h3><p>Generated footage or pure-code motion, chosen to fit the budget.</p></div></li>
      <li><span class="n">04</span><div><h3>Build &amp; ship</h3><p>Fast static site, measured for smooth scrolling, deployed where you want it.</p></div></li>
    </ol>
  </div>
</section>

<style>
  .wwm { background: var(--bone); padding-block: clamp(96px, 14vh, 160px); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .copy { display: grid; gap: 22px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .steps { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .steps li { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--line-light); }
  .n { font-family: var(--f-mono); font-size: 12px; color: var(--orange); padding-top: 5px; }
  .steps h3 { font-size: 24px; font-variation-settings: 'wdth' 112, 'wght' 740; margin-bottom: 6px; }
  .steps p { color: var(--slate); font-size: 16px; }
  @media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
